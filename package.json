{
  "name": "@choi12/rn-basic-calendar",
  "version": "0.1.8",
  "description": "A lightweight and customizable calendar component for React Native. Includes basic features like date marking and modal support.",
  "private": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "lib/index.js",
  "scripts": {
    "clean": "rm -rf lib",
    "reset": "rm -rf node_modules package-lock.json && npm install",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "pack:preview": "npm pack --dry-run",
    "pack": "npm pack",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "jest",
    "storybook": "storybook dev -p 4000",
    "build-storybook": "storybook build",
    "preview-storybook": "npx serve storybook-static",
    "deploy-storybook": "npm run build-storybook && npx gh-pages -d storybook-static",
    "deploy-storybook-ssh": "npm run build-storybook && cd storybook-static && rm -rf .git && git init && git add . && git commit -m \"Deploy storybook $(date)\" && git remote add origin git@github.com:choi12/rn-basic-calendar.git && git push -f origin HEAD:gh-pages && cd .."
  },
  "peerDependencies": {
    "dayjs": "^1.11.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-native": ">=0.65.0 <1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/community-cli-plugin": "^0.77.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-native-web-vite": "^8.6.14",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "^18.3.7",
    "@types/react-native": "0.72.8",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dayjs": "^1.11.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "4.6.2",
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.72.8",
    "react-native-web": "^0.19.13",
    "react-test-renderer": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "5.3.3",
    "vite": "^5.4.20"
  },
  "files": [
    "lib/",
    "README.md",
    "README.ko.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "react-native",
    "typescript",
    "calendar",
    "datepicker",
    "date-picker",
    "rn-calendar",
    "customizable",
    "lightweight"
  ],
  "homepage": "https://github.com/choi12/rn-basic-calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choi12/rn-basic-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/choi12/rn-basic-calendar/issues"
  },
  "author": "choi12",
  "license": "MIT"
}
