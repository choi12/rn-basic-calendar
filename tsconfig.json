{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "lib": ["ESNext"],
    "jsx": "react-native",
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@testing-library/*": ["./node_modules/@testing-library/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "lib",
    "**/__tests__/**",
    "**/*.test.tsx",
    "**/*.test.ts",
    "src/testUtils/**"
  ]
}
